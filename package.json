{
  "name": "hayasell-api",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "install:all": "pnpm install",
    "infra:up": "docker compose up -d",
    "db:generate": "pnpm --filter @hayasell/api prisma:generate",
    "db:migrate": "pnpm --filter @hayasell/api prisma:migrate -- --name init",
    "db:seed": "pnpm --filter @hayasell/api prisma:seed",
    "dev": "pnpm --filter @hayasell/api start:dev",
    "build": "pnpm --filter @hayasell/api build"
  }
}
